<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EduNexus: Notes</title>
    <link rel="stylesheet" href="/notes_style.css">
</head>
<body>
    <header>
        <div class="logo">
            <img src="/imgs/logo.png" alt="EduNexus Logo" />
        </div>
        <nav>
            <a href="/personal_profile" class="back">
                <img class="arrowleft" src="/imgs/arrowleft.png" alt="">
                <span class="back-text">Back</span>
            </a>
        </nav>
    </header>

    <main>
        <div class="note-txt">
            <button class="note-btn">Notes</button>
        </div>
        <div class="bar">
            <input type="text" id="note-blog" name="note-blog" class="box-style" placeholder="Search notes...">
            <img class="search-img" src="/imgs/upload_search.png" alt="search button">
            <div class="upload">
                <a href="/note_upload" class="upload-new-btn">
                    <span class="upload-new-text">Upload New</span>
                    <img class="plus-image" src="/imgs/plus.png" alt="plus sign">
                </a>
            </div>
        </div>

        <div class="bottom-show">
            <div class="show-notes">
                <% if (notes && notes.length > 0) { %>
                    <table class="notes-table">
                        <thead>
                            <tr>
                                <th style="width: 50%;">Title</th>
                                <th style="width: 40%;">Author</th>
                                <th style="width: 10%;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% notes.forEach(note => { %>
                                <tr>
                                    <td>
                                        <a href="/uploads/<%= note.filename %>" target="_blank"><%= note.title %></a>
                                    </td>
                                    <td>
                                        <a href="/personal_profile" target="_blank"><%= note.author %></a>
                                    </td>
                                    <td>
                                        <img class="more-img" src="/imgs/more.png" alt="more">
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                <% } else { %>
                    <p>No notes uploaded yet.</p>
                <% } %>
            </div>
            
            
        </div>
    </main>
    <style>
        .notes-table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 20px;
}

.notes-table th,
.notes-table td {
    /* border: 1px solid #ddd; */
    text-align: left;
    padding: 8px;
}


.notes-table td a {
    text-decoration: none;
    color: #0d6efd;
}

.notes-table td img {
    cursor: pointer;
    width: 20px;
    height: 20px;
}

    </style>
</body>
</html>
