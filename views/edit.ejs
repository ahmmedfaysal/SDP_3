<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EduNexus: Edit information</title>
    <link rel="stylesheet" href="/signup_style.css">
</head>
<body>
    <header>
      <div class="logo">
        <img src="/imgs/black_logo.png" alt="EduNexus Logo" />
      </div>
      <nav>
        <button class="btn help">Help</button>
      </nav>
    </header>

    <main>
        <div class="main-section">
            <button class="btn-show-signup">Edit</button>
            <div class="information1">
                <label for="name">Name</label>
                <input type="name" id="name" name="name" class="box-style">

                <label for="dropdown">Department</label>
                <select id="dropdown" name="options" class="box-style">
                    <option value="option1">CSE</option>
                    <option value="option2">EEE</option>
                    <option value="option3">Civil</option>
                    <option value="option4">BBA</option>
                    <option value="option5">English</option>
                    <option value="option6">Law</option>
                    <option value="option7">Economics</option>
                    <option value="option8">Mathematics</option>
                </select>

                <label for="intake">Intake</label>
                <input type="int" id="int" name="int" class="box-style">

                <label for="section">Section</label>
                <input type="int" id="int" name="int" class="box-style">

                <label for="email">Email</label>
                <input type="email" id="email" name="email" class="box-style">

                <label for="number">Phone no.</label>
                <input type="number" id="number" name="number" class="box-style">

                <label for="password">Password</label>
                <input type="password" id="password" name="password" class="box-style">

                <label for="password">Re-type Password</label>
                <input type="password" id="password" name="password" class="box-style">
                <a href="/personal_profile" class="save">
                    <span>Save</span>
                </a>
            </div>
        </div>
    </main>
  </body>
</html>