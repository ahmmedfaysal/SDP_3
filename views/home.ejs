<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>EduNexus</title>
    <link rel="stylesheet" href="/style.css" />
  </head>
  <body>
    <header>
      <div class="logo">
        <img src="/imgs/logo.png" alt="EduNexus Logo" />
      </div>
      <nav>
        <button class="btn about-us">About Us</button>
        <a href="./guest.html" class="btn guest">Visit as Guest</a>
      </nav>
    </header>

    <main>
      <section class="intro">
        <h1>     EduNexus: <br /></h1>
        <h2>Let’s Learn Together!</h2>
      </section>

      <div class="action-buttons">
        <div class="action-left">
          <p class="description">
            Dive into a world of knowledge and collaboration. EduNexus is your
            go-to platform for sharing, learning, and growing. Join our community
            of students and unlock your full potential.
          </p>
  
          <button class="btn meet-team">Meet our team</button>
        </div>
        <div class="auth-buttons">
          <a href="/signup" class="btn-link-signup">
            <img class="arrow-left" src="/imgs/arrowleft.png" alt="">
            <span>Signup</span>
          </a>
          <a href="/login" class="btn-link-login">
            <span>Login</span>
            <img class="arrow-right" src="/imgs/arrowright.png" alt="">
            
          </a>
          <div class="top-bg"></div>
          <!-- <div class="bottom-bg"></div> -->
          <img class="divider-img" src="/imgs/divider.svg" alt="">
        </div>
      </div>
    </main>
  </body>
</html>