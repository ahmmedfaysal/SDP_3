<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EduNexus: Profile_Guest</title>
    <link rel="stylesheet" href="/profile.css">
</head>
<body>
    <header>
        <div class="logo">
          <img src="/imgs/logo.png" alt="EduNexus Logo" />
        </div>
      </header>
      <main>
        <section class= "name-image">
            <p>Guest User</p>
            <div class="demo-user">
                <img src="/imgs/user.png" alt="demo user"/>
            </div>
            <!-- <hr> -->
        </section>

        <div class="bottom-part">
            <div class="guest-bottom-left">
                <a href="/signup" class="box-style">
                    <span>Sign Up</span>
                </a>

                <a href="/notes" class="box-style">
                    <span>Notes</span>
                </a>

                <a href="#" class="box-style">
                    <span>Blogs</span>
                </a>

                <a href="" class="box-style">
                    <span>Groups</span>
                </a>


            </div>
            <div class="bottom-right">
                <div>
                    <hr class="after-name">
                </div>
                <section class="welcome-note">
                    <p>Welcome to my profile. Hope my notes can help you for your future. Be thankful to everyone.</p>
                </section>
                <div>
                    <label for="recent">Recent Uploads</label>
                    <div class="recent-upload">
                        
                    </div>
                </div>
            </div>

        </div>

      </main>
</body>
</html>